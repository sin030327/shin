# 서버 포트
PORT=4000

# 프론트엔드 개발 서버 주소 (CORS 허용 출처). 배포 시 실제 프론트 도메인으로 교체.
CORS_ORIGIN=http://localhost:5500

# ---------------------------------------------------------------------------
# 아래는 아직 사용하지 않는 값입니다.
# 나중에 데이터베이스를 연결할 때 이 값을 채우고 src/db/index.js 를 구현하면 됩니다.
# 어떤 DB를 쓰든(PostgreSQL, MySQL, MongoDB 등) 이 한 줄만 채우면 되도록
# 연결 문자열 형태로 통일해 두었습니다.
# 예) PostgreSQL: postgres://user:password@host:5432/dbname
# 예) MySQL:      mysql://user:password@host:3306/dbname
# ---------------------------------------------------------------------------
DATABASE_URL=
