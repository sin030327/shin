# 서버 포트
PORT=4000

# 프론트엔드 개발 서버 주소 (CORS 허용 출처). 배포 시 실제 프론트 도메인으로 교체.
# 관리자 로그인 쿠키를 쓰기 때문에, '*'가 아니라 정확한 출처 하나를 지정해야 하고,
# 프론트엔드도 file://로 직접 열지 말고 반드시 로컬 서버(예: python -m http.server 8000)로
# 열어야 로그인 쿠키가 정상적으로 오갑니다.
CORS_ORIGIN=http://localhost:8000

# ---------------------------------------------------------------------------
# 관리자 페이지 로그인
# ---------------------------------------------------------------------------
# 원문 비밀번호를 그대로 저장하지 않고, bcrypt로 해시한 값을 저장합니다.
# 아래 명령으로 원하는 비밀번호의 해시를 생성한 뒤 그 결과를 붙여넣으세요.
#   cd backend
#   npm run hash-password -- "원하는비밀번호"
ADMIN_PASSWORD_HASH=

# 로그인 세션(JWT)에 서명할 때 쓰는 비밀 키. 아무 임의의 긴 문자열로 바꿔서 사용하세요.
JWT_SECRET=change-this-to-a-long-random-string

# ---------------------------------------------------------------------------
# 아래는 아직 사용하지 않는 값입니다.
# 나중에 데이터베이스를 연결할 때 이 값을 채우고 src/db/index.js 를 구현하면 됩니다.
# 어떤 DB를 쓰든(PostgreSQL, MySQL, MongoDB 등) 이 한 줄만 채우면 되도록
# 연결 문자열 형태로 통일해 두었습니다.
# 예) PostgreSQL: postgres://user:password@host:5432/dbname
# 예) MySQL:      mysql://user:password@host:3306/dbname
# ---------------------------------------------------------------------------
DATABASE_URL=
